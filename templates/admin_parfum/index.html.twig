{% extends 'base.html.twig' %}

{% block title %}Parfums{% endblock %}
{% block h1 %}Gestion des parfums{% endblock %}

{% block body %}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="{{ path('app_admin') }}">Back office</a>
        </li>

        <li class="breadcrumb-item active">
            Gestion des parfums
        </li>
    </ol>
</nav>

<a class="btn btn-success" href="{{ path('app_admin_parfum_new') }}">
     + Ajouter un nouveau parfum
</a>

<table class="table table-striped table-bordered table-hover text-center mt-3">

    <thead class="table-primary">
        <tr>       
            <th>Image</th>     
            <th>Nom</th>
            <th>Prix</th>
            <th>Contenance</th>
            <th>Type</th>
            <th>Stock</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

    {% for parfum in parfums %}

        <tr class="align-middle">

            <td>
                <img
                    class="imgRatioCarre w150"
                    src="{{ parfum.picture }}"
                    alt="{{ parfum.name }}"
                >
            </td>

            <td>{{ parfum.name }}</td>

            <td>{% set defaultVariant = parfum.variants|length > 0 ? parfum.variants|first : null %}

                {% if defaultVariant %}
                    {{ defaultVariant.price }} €
                {% else %}
                    Prix non renseigné
                {% endif %}
            </td>

            <td>
                {% for variant in parfum.variants %}
                    <span class="badge bg-secondary">
                        {{ variant.size }}
                    </span>
                {% else %}
                    —
                {% endfor %}
            </td>

            <td>{{ parfum.type }}</td>

            <td>{% set totalStock = 0 %}

                {% for variant in parfum.variants %}
                    {% set totalStock = totalStock + variant.stock %}
                {% endfor %}

                {{ totalStock }}
            </td>

            <td class="text-nowrap">
                <a class="btn btn-sm btn-outline-primary"
                title="Voir"
                href="{{ path('app_admin_parfum_show', {'id': parfum.id}) }}">
                    <i class="bi bi-eye"></i>
                </a>

                <a class="btn btn-sm btn-outline-warning"
                title="Modifier"
                href="{{ path('app_admin_parfum_edit', {'id': parfum.id}) }}">
                    <i class="bi bi-pencil"></i>
                </a>

                {{ include('admin_parfum/_delete_form.html.twig', { parfum: parfum }) }}
            </td>

        </tr>

    {% else %}

        <tr>
            <td colspan="8">
                Aucun parfum trouvé.
            </td>
        </tr>

    {% endfor %}

    </tbody>

</table>

{% endblock %}