{% extends 'base.html.twig' %}

{% block title %}Parfum{% endblock %}

{% block body %}Parfums

        <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path ('app_admin')}}">Back office</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_admin_parfum_index') }}">Gestion des Parfums</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ parfum.name }}</li>
        </ol>
    </nav>
    
    {% set defaultVariant = null %}

    {% for variant in parfum.variants %}
        {% if variant.size == '70ml' or variant.size == '70 ml' %}
            {% set defaultVariant = variant %}
        {% endif %}
    {% endfor %}

    {% if not defaultVariant %}
        {% set defaultVariant = parfum.variants|length > 0 ? parfum.variants|first : null %}
    {% endif %}

    <table class="table table-striped table-bordered table-hover text-center mt-3">
        <tbody>

            <tr>
                <th>Marque</th>
                <td>
                    {{ parfum.brand ? parfum.brand.title : 'Maison indépendante' }}
                </td>
            </tr>   

            <tr>
                <th>Nom</th>
                <td>{{ parfum.name }}</td>
            </tr>

                <tr>
                    <th>Prix</th>
                    <td>
                        {% if defaultVariant %}
                            {{ defaultVariant.price }} €
                        {% else %}
                            Prix non renseigné
                        {% endif %}
                    </td>
                </tr>

            <tr>
                <th>Contenance</th>
                <td>{% for variant in parfum.variants %}
                        <span class="badge bg-secondary">{{ variant.size }}</span>
                    {% else %}
                        —
                    {% endfor %}
                </td>
            </tr>

            <tr>
                <th>Famille</th>
                <td>
                    {% for family in parfum.families %}
                        {{ family.name }}{% if not loop.last %}, {% endif %}
                    {% else %}
                        —
                    {% endfor %}
                </td>
            </tr>

            <tr>
                <th>Type</th>
                <td>{{ parfum.type }}</td>
            </tr>
            <tr>
                <th>Photo</th>
                <td>
                    <img class="imgRatioCarre w300"
                        src="{{ parfum.picture }}"
                        alt="{{ parfum.name }}">
                </td>
            </tr>
            <tr>
                <th>Notes olfactives</th>
                <td>
                    <strong>Tête :</strong> {{ parfum.noteTete ?: '—' }}<br>
                    <strong>Cœur :</strong> {{ parfum.noteCoeur ?: '—' }}<br>
                    <strong>Fond :</strong> {{ parfum.noteFond ?: '—' }}
                </td>
            </tr>

            <tr>
                <th>Sillage</th>
                <td>
                    {{ parfum.sillage ?? 0 }}/100

                    <div class="intensity-bar">
                        <div
                            class="intensity-fill
                                {% if parfum.sillage < 40 %}
                                    intensity-low
                                {% elseif parfum.sillage < 80 %}
                                    intensity-medium
                                {% else %}
                                    intensity-high
                                {% endif %}
                            "
                            style="width: {{ parfum.sillage ?? 0 }}%;">
                        </div>
                    </div>
                </td>
            </tr>

            <tr>
                <th>Tenue</th>
                <td>
                    {{ parfum.tenue ?? 0 }}/100

                    <div class="intensity-bar">
                        <div
                            class="intensity-fill
                                {% if parfum.tenue < 40 %}
                                    intensity-low
                                {% elseif parfum.tenue < 80 %}
                                    intensity-medium
                                {% else %}
                                    intensity-high
                                {% endif %}
                            "
                            style="width: {{ parfum.tenue ?? 0 }}%;">
                        </div>
                    </div>
                </td>
            </tr>

            <tr>
                <th>Stock</th>
                <td>
                    {% set totalStock = 0 %}

                    {% for variant in parfum.variants %}
                        {% set totalStock = totalStock + variant.stock %}
                    {% endfor %}

                    {{ totalStock }} en stock
                </td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_admin_parfum_index') }}">Retour à la liste</a>

    <a href="{{ path('app_admin_parfum_edit', {'id': parfum.id}) }}">Modifier</a>

    {{ include('admin_parfum/_delete_form.html.twig') }}
{% endblock %}
