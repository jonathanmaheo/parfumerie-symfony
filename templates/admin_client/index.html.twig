{% extends 'base.html.twig' %}

{% block title %}Clients{% endblock %}
{% block h1 %}Gestion des clients{% endblock %}

{% block body %}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="{{ path('app_admin') }}">Back office</a>
        </li>

        <li class="breadcrumb-item active">
            Gestion des clients
        </li>
    </ol>
</nav>

<table class="table table-striped table-bordered table-hover text-center mt-3">

    <thead class="table-primary">
        <tr>
            <th>Nom</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

    {% for client in clients %}

        <tr class="align-middle">

            <td>{{ client.name }}</td>

            <td>{{ client.email }}</td>

            <td class="text-nowrap">

                <a class="btn btn-sm btn-outline-primary"
                title="Voir"
                href="{{ path('app_admin_client_show', {'id': client.id}) }}">
                    <i class="bi bi-eye"></i>
                </a>

                <a class="btn btn-sm btn-outline-warning"
                title="Modifier"
                href="{{ path('app_admin_client_edit', {'id': client.id}) }}">
                    <i class="bi bi-pencil"></i>
                </a>

                {{ include('admin_client/_delete_form.html.twig', { client: client }) }}
            </td>

        </tr>

    {% else %}

        <tr>
            <td colspan="3">
                Aucun client trouvé.
            </td>
        </tr>

    {% endfor %}

    </tbody>

</table>

<a class="btn btn-success" href="{{ path('app_admin_client_new') }}">
    + Ajouter un nouveau client
</a>

{% endblock %}
