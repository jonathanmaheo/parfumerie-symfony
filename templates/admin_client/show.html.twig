{% extends 'base.html.twig' %}

{% block title %}Client n°{{ client.id }}
{% endblock %}
{% block h1 %}Détail du client n°{{ client.id }}
{% endblock %}

{% block body %}

	<nav aria-label="breadcrumb">
		<ol class="breadcrumb">
			<li class="breadcrumb-item">
				<a href="{{ path('app_admin') }}">Back office</a>
			</li>

			<li class="breadcrumb-item">
				<a href="{{ path('app_admin_client_index') }}">Gestion des clients</a>
			</li>

			<li class="breadcrumb-item active">
				Client n°{{ client.id }}
			</li>
		</ol>
	</nav>

	<div class="table-responsive">
		<table class="table table-striped table-bordered mt-3">

			<tbody>
				<tr>
					<th class="col-2">N°</th>
					<td>{{ client.id }}</td>
				</tr>

				<tr>
					<th class="col-2">Nom</th>
					<td>{{ client.name }}</td>
				</tr>

				<tr>
					<th class="col-2">Email</th>
					<td>{{ client.email }}</td>
				</tr>

				<tr>
					<th class="col-2">Nombre de commandes</th>
					<td>{{ client.commandes|length }}</td>
				</tr>
			</tbody>

		</table>
	</div>

	<a class="btn btn-secondary" href="{{ path('app_admin_client_index') }}">
		Retour à la liste
	</a>

	<a class="btn btn-warning" href="{{ path('app_admin_client_edit', {'id': client.id}) }}">
		Modifier
	</a>

	{{ include('admin_client/_delete_form.html.twig', { client: client }) }}

{% endblock %}
