{% extends 'base.html.twig' %}

{% block title %}Commandes{% endblock %}
{% block h1 %}Gestion des commandes{% endblock %}

{% block body %}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="{{ path('app_admin') }}">Back office</a>
        </li>

        <li class="breadcrumb-item active">
            Gestion des commandes
        </li>
    </ol>
</nav>

<a class="btn btn-success" href="{{ path('app_admin_commande_new') }}">
    + Ajouter une nouvelle commande
</a>

<table class="table table-striped table-bordered table-hover text-center mt-3">

    <thead class="table-primary">
        <tr>
            <th>N°</th>
            <th>Date</th>
            <th>Client</th>
            <th>Nb produits</th>
            <th>Total</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

    {% for commande in commandes %}

        {% set total = 0 %}

        {% for ligne in commande.commandeProduits %}

            {% if ligne.parfumVariant %}
                {% set total = total + (ligne.parfumVariant.price * ligne.quantity) %}
            {% endif %}

        {% endfor %}

        <tr class="align-middle">

            <td>{{ commande.id }}</td>

            <td>{{ commande.date|date('d/m/Y') }}</td>

            <td>
                {% if commande.client %}
                    {{ commande.client.name }}
                {% else %}
                    —
                {% endif %}
            </td>

            <td>{{ commande.commandeProduits|length }}</td>

            <td>{{ total }} €</td>

            <td class="text-nowrap">

                <a class="btn btn-sm btn-outline-primary"
                title="Voir"
                href="{{ path('app_admin_commande_show', {'id': commande.id}) }}">
                    <i class="bi bi-eye"></i>
                </a>

                <a class="btn btn-sm btn-outline-warning"
                title="Modifier"
                href="{{ path('app_admin_commande_edit', {'id': commande.id}) }}">
                    <i class="bi bi-pencil"></i>
                </a>

                {{ include('admin_commande/_delete_form.html.twig', { commande: commande }) }}
            </td>

        </tr>

    {% else %}

        <tr>
            <td colspan="6">
                Aucune commande trouvée.
            </td>
        </tr>

    {% endfor %}

    </tbody>

</table>

{% endblock %}