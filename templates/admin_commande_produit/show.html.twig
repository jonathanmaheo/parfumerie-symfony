{% extends 'base.html.twig' %}

{% block title %}Commande-produit n°{{ commande_produit.id }}
{% endblock %}
{% block h1 %}Détail de la ligne n°{{ commande_produit.id }}
{% endblock %}

{% block body %}

	<nav aria-label="breadcrumb">
		<ol class="breadcrumb">
			<li class="breadcrumb-item">
				<a href="{{ path('app_admin') }}">Back office</a>
			</li>

			<li class="breadcrumb-item">
				<a href="{{ path('app_admin_commande_produit_index') }}">Gestion des commandes-produits</a>
			</li>

			<li class="breadcrumb-item active">
				Ligne n°{{ commande_produit.id }}
			</li>
		</ol>
	</nav>

	<div class="table-responsive">
		<table class="table table-striped table-bordered text-center mt-3">

			<thead class="table-primary">
				<tr>
					<th>N°</th>
					<th>Parfum</th>
					<th>Contenance</th>
					<th>Prix</th>
					<th>Quantité</th>
					<th>Sous-total</th>
					<th>N° commande</th>
					<th>Date</th>
					<th>Client</th>
				</tr>
			</thead>

			<tbody>
				<tr class="align-middle">

					<td>{{ commande_produit.id }}</td>

					<td>
						{% if commande_produit.parfumVariant %}
							{{ commande_produit.parfumVariant.parfum.name }}
						{% else %}
							—
						{% endif %}
					</td>

					<td>
						{% if commande_produit.parfumVariant %}
							{{ commande_produit.parfumVariant.size }}
						{% else %}
							—
						{% endif %}
					</td>

					<td>
						{% if commande_produit.parfumVariant %}
							{{ commande_produit.parfumVariant.price }}
							€
						{% else %}
							—
						{% endif %}
					</td>

					<td>{{ commande_produit.quantity }}</td>

					<td>
						{% if commande_produit.parfumVariant %}
							{{ commande_produit.parfumVariant.price * commande_produit.quantity }}
							€
						{% else %}
							—
						{% endif %}
					</td>

					<td>
						{% if commande_produit.commande %}
							<a href="{{ path('app_admin_commande_show', {'id': commande_produit.commande.id}) }}">
								#{{ commande_produit.commande.id }}
							</a>
						{% else %}
							—
						{% endif %}
					</td>

					<td>
						{% if commande_produit.commande %}
							{{ commande_produit.commande.date|date('d/m/Y') }}
						{% else %}
							—
						{% endif %}
					</td>

					<td>
						{% if commande_produit.commande and commande_produit.commande.client %}
							{{ commande_produit.commande.client.name }}
						{% else %}
							—
						{% endif %}
					</td>

				</tr>
			</tbody>

		</table>
	</div>

	<a class="btn btn-secondary" href="{{ path('app_admin_commande_produit_index') }}">
		Retour à la liste
	</a>

	{{ include('admin_commande_produit/_delete_form.html.twig', { commande_produit: commande_produit }) }}

{% endblock %}
