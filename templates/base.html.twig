<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}Welcome!
			{% endblock %}
		</title>
		<meta http-equiv="X-UA-Compatible" content="IE=7">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">

		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
		<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Poppins:wght@300;400;500&display=swap" rel="stylesheet">
		<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet">
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="{{ asset('css/style.css') }}">
		<link rel="stylesheet" href="{{ asset('css/navigation.css') }}">
		<link rel="stylesheet" href="{{ asset('css/accueil.css') }}">
		<link rel="stylesheet" href="{{ asset('css/catalogue.css') }}">
		<link rel="stylesheet" href="{{ asset('css/parfum.css') }}">
		<link rel="stylesheet" href="{{ asset('css/footer.css') }}">
		<link rel="stylesheet" href="{{ asset('css/pages.css') }}">
		<link rel="stylesheet" href="{{ asset('css/admin.css') }}">
		<link rel="stylesheet" href="{{ asset('css/form-back-office.css') }}">
		<link rel="stylesheet" href="{{ asset('css/boutons.css') }}"> {% block stylesheets %}{% endblock %}


		{% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
		{% if frankenphpHotReload %}
			<meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
			<script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
			<script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
		{% endif %}
	</head>
	{% set panierSession = app.session.get('panier', []) %}
	{% set nbArticles = 0 %}

	{% for quantite in panierSession %}
		{% set nbArticles = nbArticles + quantite %}
	{% endfor %}
	<body class="bg-body">

		{% set route = app.request.attributes.get('_route') %}
		{% if route not in ['app_login', 'app_register'] %}
			{% if route == 'app_home' %}

				<header class="main-header home-header">

					<img src="{{ asset('images/fond-ecran-nav.png') }}" class="hero-bg" alt="">
					<div class="hero-overlay"></div>

					{% include "_include/_nav.html.twig" %}

					<div class="hero-text">
						<div class="hero-subtitle">L'ART DU PARFUM</div>

						<h2>L'essence de l'élégance</h2>

						<p>
							Découvrez une sélection exclusive de parfums de niche issus des plus grandes maisons.
						</p>

						<a href="{{ path('app_catalog') }}" class="btn-hero">
							Découvrir la collection
						</a>
					</div>

				</header>

			{% elseif route in ['app_login','app_register'] %}

				<header class="simple-header">
					{% include "_include/_nav.html.twig" %}
				</header>

			{% else %}

				<header class="main-header page-header">

					<img src="{{ asset('images/fond-ecran.png') }}" class="hero-bg" alt="">

					<div class="hero-overlay"></div>

					{% include "_include/_nav.html.twig" %}

				</header>

			{% endif %}
		{% endif %}


		<main class="{% if route == 'app_home' %}home-main{% else %}container{% endif %}">
			<h1 class="text-center my-3"> {% block h1 %}{% endblock %}
				</h1>
				{% include "_include/_flashes.html.twig" %}

				{% block body %}{% endblock %}
			</main>
			{% include "_include/_footer.html.twig" %}

			<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
			<script src="{{ asset('js/script.js') }}"></script>
			{% block javascripts %}
			{# {% block importmap %}{{ importmap('app') }}{% endblock %} #}{% endblock %}
		</body>
	</html>
