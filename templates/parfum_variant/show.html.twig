{% extends 'base.html.twig' %}

{% block title %}Variante n°{{ parfum_variant.id }}
{% endblock %}
{% block h1 %}Détail de la variante n°{{ parfum_variant.id }}
{% endblock %}

{% block body %}

	<nav aria-label="breadcrumb">
		<ol class="breadcrumb">
			<li class="breadcrumb-item">
				<a href="{{ path('app_admin') }}">Back office</a>
			</li>

			<li class="breadcrumb-item">
				<a href="{{ path('app_parfum_variant_index') }}">Gestion des variantes</a>
			</li>

			<li class="breadcrumb-item active">
				Variante n°{{ parfum_variant.id }}
			</li>
		</ol>
	</nav>

	<div class="table-responsive">
		<table class="table table-striped table-bordered mt-3">

			<tbody>
				<tr>
					<th class="col-2">N°</th>
					<td>{{ parfum_variant.id }}</td>
				</tr>

				<tr>
					<th class="col-2">Parfum</th>
					<td>
						{% if parfum_variant.parfum %}
							{{ parfum_variant.parfum.name }}
						{% else %}
							—
						{% endif %}
					</td>
				</tr>

				<tr>
					<th class="col-2">Contenance</th>
					<td>{{ parfum_variant.size }}</td>
				</tr>

				<tr>
					<th class="col-2">Prix</th>
					<td>{{ parfum_variant.price }}
						€</td>
				</tr>

				<tr>
					<th class="col-2">Stock</th>
					<td>{{ parfum_variant.stock }}</td>
				</tr>

				<tr>
					<th class="col-2">Sillage</th>
					<td>
						{% if parfum_variant.parfum %}
							{{ parfum_variant.parfum.sillage }}
						{% else %}
							—
						{% endif %}
					</td>
				</tr>

				<tr>
					<th class="col-2">Tenue</th>
					<td>
						{% if parfum_variant.parfum %}
							{{ parfum_variant.parfum.tenue }}
						{% else %}
							—
						{% endif %}
					</td>
				</tr>

				<tr>
					<th class="col-2">Image</th>
					<td>
						{% if parfum_variant.image or (parfum_variant.parfum and parfum_variant.parfum.picture) %}
							<img src="{% if parfum_variant.image %}{{ asset(parfum_variant.image) }}{% else %}{{ parfum_variant.parfum.picture }}{% endif %}" alt="{{ parfum_variant.parfum.name }}" class="img-fluid" style="max-width: 120px; height: auto;">
						{% else %}
							—
						{% endif %}
					</td>
				</tr>
			</tbody>

		</table>
	</div>

	<a class="btn btn-secondary" href="{{ path('app_parfum_variant_index') }}">
		Retour à la liste
	</a>

	<a class="btn btn-warning" href="{{ path('app_parfum_variant_edit', {'id': parfum_variant.id}) }}">
		Modifier
	</a>

	{{ include('parfum_variant/_delete_form.html.twig', { parfum_variant: parfum_variant }) }}

{% endblock %}
