{% extends 'base.html.twig' %}

{% block title %}Mes commandes{% endblock %}
{% block h1 %}Mes commandes{% endblock %}

{% block body %}

	{% if commandes is empty %}

		<p>Vous n'avez pas encore de commande.</p>

		<a href="{{ path('app_catalog') }}" class="btn btn-dark">
			Découvrir les parfums
		</a>

	{% else %}

	<div class="table-responsive">
		<table class="table table-striped table-bordered table-hover text-center align-middle">

			<thead class="table-primary">
				<tr>
					<th>N°</th>
					<th>Date</th>
					<th>Total</th>
					<th>Actions</th>
				</tr>
			</thead>

			<tbody>

				{% for commande in commandes %}

					{% set total = 0 %}

					{% for ligne in commande.commandeProduits %}
						{% set total = total + (ligne.parfumVariant.price * ligne.quantity) %}
					{% endfor %}

					<tr>
						<td>{{ commande.id }}</td>
						<td>{{ commande.date|date('d/m/Y') }}</td>
						<td>{{ total }} €</td>
						<td class="text-nowrap">
							<a
								class="btn btn-sm btn-outline-primary"
								title="Voir"
								href="{{ path('app_commande_confirmation', {'id': commande.id}) }}">
								<i class="bi bi-eye"></i>
							</a>
						</td>
					</tr>

				{% endfor %}

			</tbody>

		</table>
		</div>

	{% endif %}

{% endblock %}