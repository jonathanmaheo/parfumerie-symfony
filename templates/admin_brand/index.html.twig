{% extends 'base.html.twig' %}

{% block title %}Gestion des marques{% endblock %}
{% block h1 %}Gestion des marques{% endblock %}

{% block body %}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="{{ path('app_admin') }}">Back office</a>
        </li>
        <li class="breadcrumb-item active">Gestion des marques</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">

    <a class="btn btn-success" href="{{ path('app_admin_brand_new') }}">
        + Ajouter une marque
    </a>
</div>

<div class="row g-4">

    {% for brand in brands %}

        <div class="col-md-3">

            <div class="admin-brand-card">

                <div class="admin-brand-logo">
                    <img
                        src="{{ asset('images/brands/' ~ brand.picture) }}"
                        alt="{{ brand.title }}"
                    >
                </div>

                <h3>{{ brand.title }}</h3>

                <div class="admin-brand-actions">

                    <a class="btn btn-sm btn-outline-primary"
                       href="{{ path('app_admin_brand_show', {'id': brand.id}) }}"
                       title="Voir">
                        <i class="bi bi-eye"></i>
                    </a>

                    <a class="btn btn-sm btn-outline-warning"
                       href="{{ path('app_admin_brand_edit', {'id': brand.id}) }}"
                       title="Modifier">
                        <i class="bi bi-pencil"></i>
                    </a>

                    {{ include('admin_brand/_delete_form.html.twig', { brand: brand }) }}
                </div>

            </div>

        </div>

    {% else %}

        <p>Aucune marque trouvée.</p>

    {% endfor %}

</div>

{% endblock %}