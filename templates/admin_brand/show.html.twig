{% extends 'base.html.twig' %}

{% block title %}{{ brand.title }}{% endblock %}
{% block h1 %}{{ brand.title }}{% endblock %}

{% block body %}
    
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path ('app_admin')}}">Back office</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_admin_brand_index') }}">Gestion des marques</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ brand.title }}</li>
        </ol>
    </nav>

    <table class="table">
        <tbody>
            <tr>
                <th>N°</th>
                <td>{{ brand.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ brand.title }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_admin_brand_index') }}">Retour à la liste</a>

    <a href="{{ path('app_admin_brand_edit', {'id': brand.id}) }}">Modifier</a>

    {{ include('admin_brand/_delete_form.html.twig') }}
{% endblock %}
