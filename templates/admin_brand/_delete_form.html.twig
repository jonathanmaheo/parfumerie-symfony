<form method="post"
      action="{{ path('app_admin_brand_delete', {'id': brand.id}) }}"
      style="display:inline;"
      onsubmit="return confirm('Voulez-vous vraiment supprimer cette marque ?');">

    <input type="hidden"
           name="_token"
           value="{{ csrf_token('delete' ~ brand.id) }}">

    <button type="submit"
            class="btn btn-sm btn-outline-danger"
            title="Supprimer">
        <i class="bi bi-trash"></i>
    </button>
</form>