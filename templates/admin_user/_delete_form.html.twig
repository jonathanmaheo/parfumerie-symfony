<form
    method="post"
    action="{{ path('app_admin_user_delete', {'id': user.id}) }}"
    onsubmit="return confirm('Voulez-vous vraiment supprimer ce membre ?');"
    class="d-inline"
>
    <input
        type="hidden"
        name="_token"
        value="{{ csrf_token('delete' ~ user.id) }}"
    >

    <button
        type="submit"
        class="btn btn-sm btn-outline-danger"
        title="Supprimer"
    >
        <i class="bi bi-trash"></i>
    </button>
</form>