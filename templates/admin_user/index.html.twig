{% extends 'base.html.twig' %}

{% block title %}Membres
{% endblock %}
{% block h1 %}Gestion des membres
{% endblock %}

{% block body %}

	<nav aria-label="breadcrumb">
		<ol class="breadcrumb">
			<li class="breadcrumb-item">
				<a href="{{ path('app_admin') }}">Back office</a>
			</li>

			<li class="breadcrumb-item active">
				Gestion des membres
			</li>
		</ol>
	</nav>

	<div class="table-responsive">
		<table class="table table-striped table-bordered table-hover text-center mt-3">

			<thead class="table-primary">
				<tr>
					<th>Prénom</th>
					<th>Nom</th>
					<th>Email</th>
					<th>Rôle</th>
					<th>Compte vérifié</th>
					<th>Actions</th>
				</tr>
			</thead>

			<tbody>

				{% for user in users %}

					<tr class="align-middle">

						<td>{{ user.firstName }}</td>

						<td>{{ user.lastName }}</td>

						<td>{{ user.email }}</td>

						<td>
							{% if 'ROLE_ADMIN' in user.roles %}
								<span class="badge bg-danger">
									Administrateur
								</span>
							{% else %}
								<span class="badge bg-secondary">
									Membre
								</span>
							{% endif %}
						</td>

						<td>
							{% if user.isVerified %}
								<span class="badge bg-success">
									Oui
								</span>
							{% else %}
								<span class="badge bg-warning text-dark">
									Non
								</span>
							{% endif %}
						</td>

						<td class="text-nowrap">

							<a class="btn btn-sm btn-outline-primary" title="Voir" href="{{ path('app_admin_user_show', {'id': user.id}) }}">
								<i class="bi bi-eye"></i>
							</a>

							<a class="btn btn-sm btn-outline-warning" title="Modifier" href="{{ path('app_admin_user_edit', {'id': user.id}) }}">
								<i class="bi bi-pencil"></i>
							</a>

							{{ include('admin_user/_delete_form.html.twig', { user: user }) }}

						</td>

					</tr>

				{% else %}

					<tr>
						<td colspan="6">
							Aucun membre trouvé.
						</td>
					</tr>

				{% endfor %}

			</tbody>

		</table>
	</div>

	<a class="btn btn-success" href="{{ path('app_admin_user_new') }}">
		+ Ajouter un nouveau membre
	</a>

{% endblock %}
