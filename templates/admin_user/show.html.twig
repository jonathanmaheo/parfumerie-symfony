{% extends 'base.html.twig' %}

{% block title %}Détail du membre{% endblock %}

{% block body %}

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="{{ path('app_admin') }}">Back-office</a>
            </li>

            <li class="breadcrumb-item">
                <a href="{{ path('app_admin_user_index') }}">
                    Gestion des membres
                </a>
            </li>

            <li class="breadcrumb-item active" aria-current="page">
                {{ user.firstName }} {{ user.lastName }}
            </li>
        </ol>
    </nav>

    <h1>Détail du membre</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>ID</th>
                <td>{{ user.id }}</td>
            </tr>

            <tr>
                <th>Prénom</th>
                <td>{{ user.firstName }}</td>
            </tr>

            <tr>
                <th>Nom</th>
                <td>{{ user.lastName }}</td>
            </tr>

            <tr>
                <th>Email</th>
                <td>{{ user.email }}</td>
            </tr>

            <tr>
                <th>Rôle</th>
                <td>
                    {% if 'ROLE_ADMIN' in user.roles %}
                        Administrateur
                    {% else %}
                        Membre
                    {% endif %}
                </td>
            </tr>

            <tr>
                <th>Compte vérifié</th>
                <td>
                    {{ user.isVerified ? 'Oui' : 'Non' }}
                </td>
            </tr>
        </tbody>
    </table>

    <div class="actions">

        <a
            href="{{ path('app_admin_user_index') }}"
            class="btn-action btn-show"
        >
            Retour à la liste
        </a>

        <a
            href="{{ path('app_admin_user_edit', {'id': user.id}) }}"
            class="btn-action btn-edit"
        >
            Modifier
        </a>

        {{ include('admin_user/_delete_form.html.twig') }}

    </div>

{% endblock %}