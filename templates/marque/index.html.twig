{% extends 'base.html.twig' %}

{% block title %}Nos marques{% endblock %}

{% block body %}
    <h1 style="text-align:center; margin;20px 0;">Nos marques</h1>

    <div style="
    display:flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: center;
    ">
    
    {% for brand in brands %}

    <a href="{{  path('app_brand_show', {id: brand.id}) }}"
    style="
        width: 180px;
        text-align: center;
        text-decoration: none;
        color: black;
        border: 1px solid #eee;
        border-radius: 10px;
        padding: 10px;
        ">

        <img 
            src="{{ asset('images/brands/' ~ brand.picture) }}"
            style=
            "width: 100%; height: 120px; object-fit: contain;" alt="">
        
        <h3>{{ brand.title }}</h3>
        </a>

        {% endfor %}
    </div>
{% endblock %}