{% extends 'base.html.twig' %}

{% block h1 %}{{ brand.title }}{% endblock %}

{% block body %}

<div class="row g-5">

    {% for parfum in parfums %}

        {% set firstVariant = parfum.variants|first %}

        <div class="col-md-3">

            <div class="lux-card">

                <div class="lux-image">
                    <img
                        id="img-{{ parfum.id }}"
                        src="{{parfum.picture}}"
                        alt="{{ parfum.name }}"
                        style="transition: opacity 0.2s ease;"
                    >
                </div>

                <div class="lux-content">

                    <p class="lux-brand">
                        {{ parfum.brand ? parfum.brand.title : 'Maison indépendante' }}
                    </p>

                    <h2 class="lux-title">
                        {{ parfum.name }}
                    </h2>

                    <div class="lux-families">
                        {% for family in parfum.families %}
                            <span>{{ family.name }}</span>
                        {% endfor %}
                    </div>

                    <div class="lux-variants">

                        {% for variant in parfum.variants %}

                            <button
                                class="variant-btn"
                                onclick="changeVariant(
                                    {{ parfum.id }},
                                    '{{ asset(variant.image) }}',
                                    '{{ variant.price }}',
                                    this
                                )"
                            >
                                {{ variant.size }}
                            </button>

                        {% endfor %}

                    </div>

                    <p class="lux-price" id="price-{{ parfum.id }}">
                        {% if firstVariant %}
                            {{ firstVariant.price }} €
                        {% else %}
                            {% set defaultVariant = parfum.variants|length > 0 ? parfum.variants|first : null %}
                        {% if defaultVariant %}
                            {{ defaultVariant.price }} €
                        {% else %}
                            Prix non renseigné
                        {% endif %}
                        {% endif %}
                    </p>

                    {# 🔥 seul changement important #}
                    <a href="{{ path('app_parfum', {id: parfum.id}) }}"
                       class="lux-link">
                        Découvrir
                    </a>

                </div>

            </div>

        </div>

    {% endfor %}

</div>
<script>
function changeVariant(id, image, price, btn) {
    const img = document.getElementById('img-' + id);
    const priceEl = document.getElementById('price-' + id);

    if (!img || !priceEl) return;

    img.style.opacity = 0;

    setTimeout(() => {
        img.src = image;
        img.style.opacity = 1;
    }, 150);

    priceEl.innerText = price + " €";

    const card = btn.closest('.lux-card');

    if (card) {
        card.querySelectorAll('.variant-btn')
            .forEach(b => b.classList.remove('active'));

        btn.classList.add('active');
    }
}
</script>

{% endblock %}